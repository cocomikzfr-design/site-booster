{%- comment -%}
  Jauge de livraison offerte : rail de laiton + petit cadran qui tourne proportionnellement.
  Le seuil est saisi en euros dans les réglages (montant dans la devise de la boutique).
{%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | default: 0 | times: 100
  assign total = cart.total_price
  if threshold > 0
    assign remaining = threshold | minus: total
    assign remaining_money = remaining | money
    assign ratio = total | times: 1.0 | divided_by: threshold
    if ratio > 1
      assign ratio = 1
    endif
  endif
-%}
{%- if threshold > 0 -%}
  <div class="ship" data-ship data-ratio="{{ ratio | round: 4 }}" style="--ratio:{{ ratio | round: 4 }}">
    <svg class="ship__dial" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.2"/>
      <path class="ship__hand" d="M12 12V4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <circle cx="12" cy="12" r="1.6" fill="currentColor"/>
    </svg>
    <div class="ship__body">
      <p class="ship__text">
        {%- if remaining > 0 -%}
          {{ 'cart.free_shipping_remaining_html' | t: amount: remaining_money }}
        {%- else -%}
          {{ 'cart.free_shipping_reached' | t }}
        {%- endif -%}
      </p>
      <div class="ship__rail" role="progressbar" aria-label="{{ 'cart.free_shipping_progress' | t }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ ratio | times: 100 | round }}">
        <span class="ship__fill"></span>
      </div>
    </div>
  </div>
{%- endif -%}
