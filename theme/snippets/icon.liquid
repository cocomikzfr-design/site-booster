{%- comment -%}
  Icônes SVG inline : trait 1.4px, currentColor, viewBox 24. Paramètres : icon, class (facultatif).
{%- endcomment -%}
<svg class="icon{% if class %} {{ class }}{% endif %}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'cart' -%}<path d="M5 8h14l-1.2 11.2a1 1 0 0 1-1 .8H7.2a1 1 0 0 1-1-.8L5 8z"/><path d="M9 10V6.5a3 3 0 0 1 6 0V10"/>
    {%- when 'search' -%}<circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l5 5"/>
    {%- when 'menu' -%}<path d="M3 8h18M3 16h12"/>
    {%- when 'close' -%}<path d="M5 5l14 14M19 5L5 19"/>
    {%- when 'arrow-left' -%}<path d="M20 12H4M10 6l-6 6 6 6"/>
    {%- when 'arrow-right' -%}<path d="M4 12h16M14 6l6 6-6 6"/>
    {%- when 'arrow-down' -%}<path d="M12 4v16M6 14l6 6 6-6"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'star4' -%}<path d="M12 2c.5 5.4 4.6 9.5 10 10-5.4.5-9.5 4.6-10 10-.5-5.4-4.6-9.5-10-10 5.4-.5 9.5-4.6 10-10z" fill="currentColor" stroke="none"/>
    {%- when 'shield' -%}<path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/>
    {%- when 'sun-off' -%}<circle cx="12" cy="12" r="3.5"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/><path d="M3 3l18 18"/>
    {%- when 'drop' -%}<path d="M12 3c3.5 4.4 6 7.7 6 10.5a6 6 0 0 1-12 0C6 10.7 8.5 7.4 12 3z"/>
    {%- when 'box' -%}<path d="M3.5 7.5L12 3l8.5 4.5v9L12 21l-8.5-4.5v-9z"/><path d="M3.5 7.5L12 12l8.5-4.5M12 12v9"/>
    {%- when 'ruler' -%}<rect x="2.5" y="8" width="19" height="8" rx="1"/><path d="M6.5 8v3M10 8v4M13.5 8v3M17 8v4"/>
    {%- when 'truck' -%}<path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3v3h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="16.5" cy="17.5" r="1.8"/>
    {%- when 'check' -%}<path d="M4.5 12.5l5 5 10-11"/>
    {%- when 'play' -%}<path d="M8 5.5v13l10.5-6.5L8 5.5z"/>
    {%- when 'pause' -%}<path d="M8.5 5.5v13M15.5 5.5v13"/>
    {%- when 'user' -%}<circle cx="12" cy="8.5" r="3.8"/><path d="M4.5 20.5c.9-4 3.8-6 7.5-6s6.6 2 7.5 6"/>
    {%- when 'link' -%}<path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4L11.7 6"/><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1.3-1.3"/>
    {%- when 'lock' -%}<rect x="5" y="10.5" width="14" height="10" rx="1"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>
    {%- when 'return' -%}<path d="M9 7H15.5a5 5 0 0 1 0 10H6"/><path d="M12 3.5L8.5 7 12 10.5"/>
    {%- when 'chat' -%}<path d="M4 5.5h16v10H10l-4.5 4v-4H4z"/>
    {%- when 'zoom' -%}<circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l5 5M10.5 8v5M8 10.5h5"/>
    {%- when 'filter' -%}<path d="M4 7h16M7 12h10M10 17h4"/>
    {%- when 'instagram' -%}<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6" fill="currentColor"/>
    {%- when 'tiktok' -%}<path d="M14 3.5v11a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3.5c.5 2.8 2.4 4.6 5 4.8"/>
    {%- when 'youtube' -%}<rect x="2.5" y="5.5" width="19" height="13" rx="3.5"/><path d="M10 9.2v5.6l4.8-2.8L10 9.2z"/>
  {%- endcase -%}
</svg>
