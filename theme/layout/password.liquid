<!doctype html>
{%- comment -%} Gabarit de la page mot de passe (boutique fermée) : pas de header ni de footer. {%- endcomment -%}
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_vault }}">
    <meta name="robots" content="noindex">
    {%- render 'meta-tags' -%}
    {{ 'fraunces-roman.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    <style>
      @font-face { font-family: "Fraunces"; src: url({{ 'fraunces-roman.woff2' | asset_url }}) format("woff2"); font-weight: 300 600; font-style: normal; font-display: swap; }
      @font-face { font-family: "Fraunces"; src: url({{ 'fraunces-italic.woff2' | asset_url }}) format("woff2"); font-weight: 300 500; font-style: italic; font-display: swap; }
      @font-face { font-family: "Inter Tight"; src: url({{ 'inter-tight-500.woff2' | asset_url }}) format("woff2"); font-weight: 500; font-display: swap; }
      @font-face { font-family: "Inter Tight"; src: url({{ 'inter-tight-600.woff2' | asset_url }}) format("woff2"); font-weight: 600; font-display: swap; }
      :root {
        --vault: {{ settings.color_vault }}; --vault-2: {{ settings.color_vault_2 }}; --glass: {{ settings.color_glass }};
        --paper: {{ settings.color_paper }}; --ink: {{ settings.color_ink }}; --brass: {{ settings.color_brass }};
        --brass-deep: {{ settings.color_brass_deep }}; --slate: {{ settings.color_slate }}; --signal: {{ settings.color_signal }};
      }
    </style>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script>
      document.documentElement.classList.replace('no-js', 'js');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('reduce-motion');
    </script>
    {{ content_for_header }}
  </head>
  <body class="tpl-password world-dark">
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
