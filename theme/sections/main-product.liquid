{%- comment -%}
  Fiche produit. Galerie collante (colonnes 1–7) sur un socle, informations (8–12) en blocs réordonnables,
  puis Caractéristiques (métachamps renseignés uniquement), Compatibilité (schéma à l'échelle si
  dimensions_interieures est au format « L × l × h mm »), Livraison. Barre d'achat collante sur mobile.
{%- endcomment -%}
{{ 'product.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign featured = current.featured_media | default: product.featured_media
  assign m = product.metafields.custom
  assign form_id = 'ProductForm-' | append: section.id
  assign brand = settings.brand_name | default: shop.name
-%}

<section class="pdp world-light" data-product-root data-section-id="{{ section.id }}" data-url="{{ product.url }}">
  <nav class="wrap crumbs lbl" aria-label="{{ 'accessibility.breadcrumb' | t }}">
    <a href="{{ routes.root_url }}" class="ul ul--hover">{{ 'accessibility.home' | t }}</a>
    {%- if collection -%}<span aria-hidden="true">/</span><a href="{{ collection.url }}" class="ul ul--hover">{{ collection.title | escape }}</a>{%- endif -%}
    <span aria-hidden="true">/</span><span aria-current="page" class="dim">{{ product.title | escape }}</span>
  </nav>

  <div class="wrap pdp__grid{% if section.settings.hide_gallery %} pdp__grid--solo{% endif %}">
    {%- unless section.settings.hide_gallery -%}
      <div class="pdp__media">
        <div class="pg" data-gallery>
          <div class="pg__stage">
            <div class="pg__main" data-tilt>
              {%- for media in product.media -%}
                {%- assign is_active = false -%}
                {%- if media.id == featured.id -%}{%- assign is_active = true -%}{%- endif -%}
                <figure class="pg__slide{% if is_active %} is-active{% endif %}" data-media-id="{{ media.id }}" data-fly-src data-media-type="{{ media.media_type }}" aria-label="{{ 'accessibility.image_of' | t: index: forloop.index, count: product.media.size }}">
                  {%- case media.media_type -%}
                    {%- when 'image' -%}
                      {%- if is_active -%}
                        {%- render 'responsive-image', image: media.preview_image, widths: '480,720,960,1200,1500', sizes: '(min-width: 1100px) 52vw, (min-width: 768px) 56vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: media.alt, attrs: 'style="view-transition-name: vt-product-media" data-vt-media' -%}
                      {%- else -%}
                        {%- render 'responsive-image', image: media.preview_image, widths: '480,720,960,1200,1500', sizes: '(min-width: 1100px) 52vw, (min-width: 768px) 56vw, 100vw', alt: media.alt -%}
                      {%- endif -%}
                    {%- when 'video' -%}
                      {{ media | video_tag: controls: true, preload: 'none', playsinline: true, image_size: '1200x' }}
                    {%- when 'external_video' -%}
                      {{ media | external_video_tag }}
                    {%- when 'model' -%}
                      {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true }}
                  {%- endcase -%}
                </figure>
              {%- else -%}
                <figure class="pg__slide is-active" data-fly-src><img src="{{ 'placeholder-case.svg' | asset_url }}" alt="" width="400" height="500" style="view-transition-name: vt-product-media"></figure>
              {%- endfor -%}
              <span class="pg__glare" aria-hidden="true"></span>
            </div>
            <span class="pg__socle" aria-hidden="true"></span>
            {%- if product.media.size > 0 -%}
              <button type="button" class="btn--icon pg__zoom" data-zoom aria-label="{{ 'accessibility.zoom' | t }}">{% render 'icon', icon: 'zoom' %}</button>
            {%- endif -%}
          </div>
          {%- if product.media.size > 1 -%}
            <div class="pg__thumbs-wrap">
              <ul class="pg__thumbs" role="list" aria-label="{{ 'products.thumbnails' | t }}">
                {%- for media in product.media -%}
                  <li>
                    <button type="button" class="pg__thumb" data-thumb="{{ media.id }}" aria-label="{{ 'accessibility.image_of' | t: index: forloop.index, count: product.media.size }}"{% if media.id == featured.id %} aria-current="true"{% endif %}>
                      {%- render 'responsive-image', image: media.preview_image, widths: '120,180,240', sizes: '80px', alt: '' -%}
                      {%- if media.media_type != 'image' -%}<span class="pg__badge">{% render 'icon', icon: 'play' %}</span>{%- endif -%}
                    </button>
                  </li>
                {%- endfor -%}
              </ul>
              <span class="pg__frame" aria-hidden="true"></span>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endunless -%}

    <div class="pdp__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'labels' -%}
            <div class="pi pi--labels" data-reveal="rise" data-reveal-wait style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              {%- if product.type != blank -%}<span class="box">{{ product.type | escape }}</span>{%- endif -%}
              <span class="box box--num" data-sku{% if current.sku == blank %} hidden{% endif %}>{{ 'products.reference' | t }} {{ current.sku | escape }}</span>
            </div>
          {%- when 'title' -%}
            <h1 class="h-sec pdp__title" data-split-lines {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>
          {%- when 'price' -%}
            <div class="pi pi--price" data-reveal="rise" data-reveal-wait style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <div data-pdp-price>{%- render 'price', product: product, variant: current, size: 'lg' -%}</div>
              {%- if settings.tax_note != blank -%}<p class="pdp__tax dim">{{ settings.tax_note | escape }}</p>{%- endif -%}
            </div>
          {%- when 'compat' -%}
            {%- if m.compatibilite.value != blank -%}
              <p class="pi pi--compat lbl" data-reveal="rise" data-reveal-wait style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>{% render 'icon', icon: 'ruler' %}{{ m.compatibilite.value | escape }}</p>
            {%- endif -%}
          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="pi prose pdp__desc" data-reveal="rise" data-reveal-wait style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}
          {%- when 'variants' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="pi picker" data-variant-picker data-reveal="rise" data-reveal-wait style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  {%- assign first_value = option.values | first -%}
                  <fieldset class="picker__opt" data-option>
                    <legend class="lbl dim">{{ option.name | escape }} : <span data-option-value>{{ option.selected_value | escape }}</span></legend>
                    {%- if first_value.swatch.color -%}
                      <div class="swatches">
                        {%- for value in option.values -%}
                          <label class="swatch{% unless value.available %} is-disabled{% endunless %}" style="--swatch: {{ value.swatch.color }}">
                            <input type="radio" name="opt-{{ section.id }}-{{ option.position }}" value="{{ value | escape }}"{% if value.selected %} checked{% endif %}>
                            <span class="visually-hidden">{{ value | escape }}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    {%- elsif option.values.size <= 6 -%}
                      <div class="chips chips--scroll">
                        {%- for value in option.values -%}
                          <label class="box chip{% unless value.available %} is-disabled{% endunless %}">
                            <input type="radio" name="opt-{{ section.id }}-{{ option.position }}" value="{{ value | escape }}"{% if value.selected %} checked{% endif %}>{{ value | escape }}
                          </label>
                        {%- endfor -%}
                      </div>
                    {%- else -%}
                      <select class="select" aria-label="{{ option.name | escape }}">
                        {%- for value in option.values -%}
                          <option value="{{ value | escape }}"{% if value.selected %} selected{% endif %}>{{ value | escape }}</option>
                        {%- endfor -%}
                      </select>
                    {%- endif -%}
                  </fieldset>
                {%- endfor -%}
                <script type="application/json" data-variants>
                  [{%- for v in product.variants -%}{"id": {{ v.id }}, "available": {{ v.available | json }}, "options": {{ v.options | json }}, "media": {{ v.featured_media.id | default: 'null' }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
                </script>
              </div>
            {%- endunless -%}
          {%- when 'quantity' -%}
            <div class="pi pi--qty" data-reveal="rise" data-reveal-wait style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <label for="Qty-{{ section.id }}" class="lbl dim">{{ 'products.quantity' | t }}</label>
              <div class="qty">
                <button type="button" data-step="-1" aria-label="{{ 'products.decrease' | t }}">{% render 'icon', icon: 'minus' %}</button>
                <input id="Qty-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric" form="{{ form_id }}">
                <button type="button" data-step="1" aria-label="{{ 'products.increase' | t }}">{% render 'icon', icon: 'plus' %}</button>
              </div>
            </div>
          {%- when 'buy' -%}
            <div class="pi pi--buy" data-reveal="rise" data-reveal-wait style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'pdp__form', data-product-form: '', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
                <div data-add-wrap>
                  {%- if current.available -%}
                    {%- assign label = 'products.add_to_cart' | t -%}
                    <button type="submit" class="btn btn--block" data-add{% if settings.anim_magnetic %} data-magnetic{% endif %}>{% render 'icon', icon: 'cart' %}{% render 'btn-label', text: label %}</button>
                  {%- else -%}
                    {%- assign label = 'products.sold_out' | t -%}
                    <button type="submit" class="btn btn--block" data-add aria-disabled="true" disabled>{% render 'btn-label', text: label %}</button>
                  {%- endif -%}
                </div>
                {%- if block.settings.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
                <p class="form-msg form-msg--error" data-form-error role="alert" hidden></p>
              {%- endform -%}
            </div>
          {%- when 'delivery' -%}
            <div class="pi" data-reveal="rise" data-reveal-wait style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>{%- render 'delivery-estimate' -%}</div>
          {%- when 'reassurance' -%}
            <ul class="pi reassure" role="list" data-reveal="rise" data-reveal-wait style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <li>{% render 'icon', icon: 'lock' %}<span>{{ 'products.reassurance_payment' | t }}</span></li>
              <li>{% render 'icon', icon: 'return' %}<span>{{ 'products.reassurance_returns' | t }}</span></li>
              <li>{% render 'icon', icon: 'chat' %}<span>{{ 'products.reassurance_service' | t }}</span></li>
            </ul>
          {%- when 'share' -%}
            <div class="pi" data-reveal="rise" data-reveal-wait style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <button type="button" class="lbl pdp__share" data-copy-link data-url="{{ request.origin }}{{ product.url }}">{% render 'icon', icon: 'link' %}<span class="ul">{{ 'products.share' | t }}</span>{% render 'icon', icon: 'check', class: 'pdp__share-ok' %}</button>
            </div>
          {%- when '@app' -%}
            <div class="pi">{% render block %}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} Caractéristiques : une ligne par métachamp renseigné {%- endcomment -%}
  {%- assign spec_keys = 'dimensions_interieures,dimensions_exterieures,epaisseur_mm,matiere,fermeture,protection_uv,capacite,contenu_pack' | split: ',' -%}
  {%- capture spec_rows -%}
    {%- for k in spec_keys -%}
      {%- assign mf = product.metafields.custom[k] -%}
      {%- if mf.value != blank -%}
        <tr>
          <th scope="row">
            {%- case k -%}
              {%- when 'dimensions_interieures' -%}{{ 'products.specs.dimensions_interieures' | t }}
              {%- when 'dimensions_exterieures' -%}{{ 'products.specs.dimensions_exterieures' | t }}
              {%- when 'epaisseur_mm' -%}{{ 'products.specs.epaisseur_mm' | t }}
              {%- when 'matiere' -%}{{ 'products.specs.matiere' | t }}
              {%- when 'fermeture' -%}{{ 'products.specs.fermeture' | t }}
              {%- when 'protection_uv' -%}{{ 'products.specs.protection_uv' | t }}
              {%- when 'capacite' -%}{{ 'products.specs.capacite' | t }}
              {%- when 'contenu_pack' -%}{{ 'products.specs.contenu_pack' | t }}
            {%- endcase -%}
          </th>
          <td>
            {%- case k -%}
              {%- when 'contenu_pack' -%}{{ mf.value | join: ' · ' | escape }}
              {%- when 'epaisseur_mm' -%}{{ mf.value }} mm
              {%- else -%}{{ mf.value | escape }}
            {%- endcase -%}
          </td>
        </tr>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- liquid
    assign raw = m.dimensions_interieures.value | default: '' | downcase | replace: 'mm', '' | replace: '×', 'x' | replace: ',', '.' | strip
    assign parts = raw | split: 'x'
    assign can_draw = false
    if parts.size == 3
      unless raw contains '['
        assign dim_l = parts[0] | strip | plus: 0
        assign dim_w = parts[1] | strip | plus: 0
        assign dim_h = parts[2] | strip | plus: 0
        if dim_l > 0 and dim_h > 0 and dim_w > 0
          assign can_draw = true
        endif
      endunless
    endif
  -%}

  {%- if spec_rows != blank or can_draw or m.compatibilite.value != blank or section.settings.show_delivery -%}
    <div class="wrap pdp__more">
      {%- if spec_rows != blank -%}
        <section class="pdp__panel" aria-labelledby="Specs-{{ section.id }}">
          <h2 class="h-sub" id="Specs-{{ section.id }}" data-reveal="lines"><span class="line"><span>{{ 'products.features' | t }}</span></span></h2>
          <table class="specs mono" data-reveal="clip-up">{{ spec_rows }}</table>
        </section>
      {%- endif -%}

      {%- if can_draw or m.compatibilite.value != blank -%}
        <section class="pdp__panel" aria-labelledby="Compat-{{ section.id }}">
          <h2 class="h-sub" id="Compat-{{ section.id }}" data-reveal="lines"><span class="line"><span>{{ 'products.compatibility' | t }}</span></span></h2>
          {%- if m.compatibilite.value != blank -%}<p class="pdp__compat-line">{{ m.compatibilite.value | escape }}</p>{%- endif -%}
          {%- if can_draw -%}
            {%- liquid
              assign e = m.epaisseur_mm.value | default: 0 | plus: 0
              assign out_l = e | times: 2 | plus: dim_l
              assign out_h = e | times: 2 | plus: dim_h
              assign maxd = dim_l
              if dim_h > maxd
                assign maxd = dim_h
              endif
              assign pad = maxd | times: 0.22
              assign vb_w = pad | times: 2 | plus: out_l
              assign vb_h = pad | times: 2 | plus: out_h
              assign fs = maxd | times: 0.07
              assign sw = maxd | times: 0.006
              assign set_l = dim_l | times: 0.96
              assign set_h = dim_h | times: 0.96
              assign cx = dim_l | minus: set_l | divided_by: 2 | plus: pad | plus: e
              assign cy = dim_h | minus: set_h | plus: pad | plus: e
              assign ix = pad | plus: e
              assign iy = pad | plus: e
              assign base_y = out_h | plus: pad | plus: fs | plus: fs
              assign right_x = out_l | plus: pad | plus: fs
              assign mid_x = out_l | divided_by: 2 | plus: pad
              assign mid_y = out_h | divided_by: 2 | plus: pad
            -%}
            <figure class="compat" data-reveal="draw">
              <svg viewBox="0 0 {{ vb_w }} {{ vb_h | plus: fs | plus: fs | plus: fs }}" role="img" aria-label="{{ 'products.compat_inner' | t }} : {{ m.dimensions_interieures.value | escape }}" style="--sw: {{ sw }}px">
                {%- if e > 0 -%}<rect data-draw pathLength="1" x="{{ pad }}" y="{{ pad }}" width="{{ out_l }}" height="{{ out_h }}" class="compat__box"/>{%- endif -%}
                <rect data-draw pathLength="1" x="{{ ix }}" y="{{ iy }}" width="{{ dim_l }}" height="{{ dim_h }}" class="compat__box compat__inner"/>
                <g class="compat__set"><rect x="{{ cx }}" y="{{ cy }}" width="{{ set_l }}" height="{{ set_h }}" class="compat__coffret"/></g>
                <g class="compat__dims" font-size="{{ fs }}">
                  <line x1="{{ ix }}" y1="{{ base_y | minus: fs }}" x2="{{ ix | plus: dim_l }}" y2="{{ base_y | minus: fs }}"/>
                  <text x="{{ mid_x }}" y="{{ base_y | plus: fs }}" text-anchor="middle">{{ parts[0] | strip }} mm</text>
                  <line x1="{{ right_x }}" y1="{{ iy }}" x2="{{ right_x }}" y2="{{ iy | plus: dim_h }}"/>
                  <text x="{{ right_x | plus: fs }}" y="{{ mid_y }}" dominant-baseline="middle">{{ parts[2] | strip }} mm</text>
                </g>
              </svg>
              <figcaption class="compat__legend lbl">
                <span><i class="compat__key"></i>{{ 'products.compat_box' | t }}</span>
                <span><i class="compat__key compat__key--set"></i>{{ 'products.compat_set' | t }}</span>
                <span class="mono">{{ 'products.compat_inner' | t }} : {{ m.dimensions_interieures.value | escape }}</span>
              </figcaption>
            </figure>
          {%- endif -%}
          <p class="pdp__measure dim">{{ 'products.compat_measure' | t }}</p>
        </section>
      {%- endif -%}

      {%- if section.settings.show_delivery -%}
        <section class="pdp__panel" aria-labelledby="Delivery-{{ section.id }}">
          <h2 class="h-sub" id="Delivery-{{ section.id }}" data-reveal="lines"><span class="line"><span>{{ 'products.delivery' | t }}</span></span></h2>
          {%- render 'delivery-estimate' -%}
          {%- if section.settings.shipping_page != blank -%}
            <a href="{{ section.settings.shipping_page.url }}" class="ul lbl pdp__more-link">{{ 'products.delivery_more' | t }}</a>
          {%- endif -%}
        </section>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} Barre d'achat collante (mobile) : soumet le formulaire principal {%- endcomment -%}
  <div class="sticky-buy world-dark" data-sticky-buy>
    <div class="sticky-buy__in">
      <div class="sticky-buy__info">
        <p class="sticky-buy__title">{{ product.title | escape }}</p>
        <div data-sticky-price>{%- render 'price', product: product, variant: current -%}</div>
      </div>
      <div data-sticky-add>
        {%- assign label = 'products.add_to_cart' | t -%}
        <button type="submit" form="{{ form_id }}" class="btn"{% unless current.available %} aria-disabled="true" disabled{% endunless %} aria-label="{{ label }} : {{ product.title | escape }}">{% render 'icon', icon: 'cart' %}</button>
      </div>
    </div>
  </div>

  {%- render 'structured-data-product' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ brand | json }}, "item": {{ request.origin | append: routes.root_url | json }} },
        {%- if collection -%}
          { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ request.origin | append: collection.url | json }} },
          { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
        {%- else -%}
          { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
        {%- endif -%}
      ]
    }
  </script>
</section>

<script type="module" src="{{ 'product-gallery.js' | asset_url }}"></script>
<script type="module" src="{{ 'product-form.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Fiche produit",
  "settings": [
    { "type": "checkbox", "id": "hide_gallery", "label": "Masquer la galerie", "default": false, "info": "Pour la fiche d'un kit, où la vue éclatée remplace la galerie." },
    { "type": "checkbox", "id": "show_delivery", "label": "Afficher le bloc Livraison", "default": true },
    { "type": "page", "id": "shipping_page", "label": "Page Livraison et retours" }
  ],
  "blocks": [
    { "type": "labels", "name": "Type et référence", "limit": 1 },
    { "type": "title", "name": "Titre", "limit": 1 },
    { "type": "price", "name": "Prix", "limit": 1 },
    { "type": "compat", "name": "Ligne de compatibilité", "limit": 1 },
    { "type": "description", "name": "Description", "limit": 1 },
    { "type": "variants", "name": "Variantes", "limit": 1 },
    { "type": "quantity", "name": "Quantité", "limit": 1 },
    {
      "type": "buy", "name": "Ajout au panier", "limit": 1,
      "settings": [ { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Boutons de paiement accéléré", "default": true } ]
    },
    { "type": "delivery", "name": "Livraison estimée", "limit": 1 },
    { "type": "reassurance", "name": "Réassurance", "limit": 1 },
    { "type": "share", "name": "Copier le lien", "limit": 1 },
    { "type": "@app" }
  ]
}
{% endschema %}
