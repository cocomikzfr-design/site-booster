{%- comment -%} Mot de passe : rideau métallique fermé « OUVERTURE BIENTÔT », newsletter (tag « ouverture »), accès discret. {%- endcomment -%}
{{ 'pages.css' | asset_url | stylesheet_tag }}
<section class="pw world-dark">
  <div class="pw__shutter" aria-hidden="true"><span class="pw__plate lbl">{{ 'password.soon' | t }}</span></div>
  <div class="wrap pw__in">
    {%- render 'logo' -%}
    {%- assign pw_title = 'password.title' | t -%}
    <h1 class="h-sec" data-reveal="lines"><span class="line"><span>{{ section.settings.title | default: pw_title | escape }}</span></span></h1>
    {%- if shop.password_message != blank -%}<p class="lede">{{ shop.password_message | escape }}</p>{%- else -%}<p class="lede">{{ 'password.text' | t }}</p>{%- endif -%}
    {%- form 'customer', id: 'PwNewsletter', class: 'pw__nl' -%}
      <input type="hidden" name="contact[tags]" value="ouverture">
      {%- if form.posted_successfully? -%}
        <p class="h-sub" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="inline-form">
          <label for="PwEmail" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
          <input id="PwEmail" type="email" name="contact[email]" class="input" autocomplete="email" required placeholder="{{ 'newsletter.email' | t }}">
          <button type="submit" class="btn">{%- assign label = 'newsletter.submit' | t -%}{%- render 'btn-label', text: label -%}</button>
        </div>
        {%- if form.errors -%}<p class="form-msg form-msg--error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
    <details class="pw__access">
      <summary class="lbl dim">{{ 'password.access' | t }}</summary>
      {%- form 'storefront_password', class: 'inline-form pw__form' -%}
        <label for="PwPassword" class="visually-hidden">{{ 'password.password' | t }}</label>
        <input id="PwPassword" type="password" name="password" class="input" autocomplete="current-password" placeholder="{{ 'password.password' | t }}"{% if form.errors %} aria-invalid="true"{% endif %}>
        <button type="submit" class="btn btn--ghost">{%- assign label = 'password.enter' | t -%}{%- render 'btn-label', text: label -%}</button>
        {%- if form.errors -%}<p class="form-msg form-msg--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
      <p class="dim pw__admin">{{ 'password.admin' | t }} <a href="/admin" class="ul">{{ 'password.admin_link' | t }}</a></p>
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Mot de passe",
  "settings": [ { "type": "text", "id": "title", "label": "Titre", "default": "La galerie ouvre bientôt." } ]
}
{% endschema %}
