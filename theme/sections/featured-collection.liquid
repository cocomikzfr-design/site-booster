{%- comment -%} Collection mise en avant : grille de cartes produit, apparition par découpe de bas en haut. {%- endcomment -%}
{{ 'home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign coll = section.settings.collection
  if coll == blank
    assign coll = collections.all
  endif
-%}
<section class="section world-light featured" aria-labelledby="FeaturedTitle-{{ section.id }}">
  <div class="wrap">
    <div class="sec-head">
      <div>
        {%- if section.settings.kicker != blank -%}<p class="box box--brass sec-head__kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
        <h2 class="h-sec" id="FeaturedTitle-{{ section.id }}" data-reveal="lines"><span class="line"><span>{{ section.settings.title | escape }}</span></span></h2>
      </div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ coll.url }}" class="btn btn--ghost">{%- render 'btn-label', text: section.settings.button_label -%}</a>
      {%- endif -%}
    </div>
    <ul class="grid grid--4" role="list">
      {%- for p in coll.products limit: section.settings.limit -%}
        <li>{%- render 'product-card', product: p, index: forloop.index0, reveal: true -%}</li>
      {%- else -%}
        <li class="dim">{{ 'collections.empty_collection' | t }}</li>
      {%- endfor -%}
    </ul>
  </div>
</section>
<script type="module" src="{{ 'product-form.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Collection mise en avant",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "N° 04 — La collection" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Les pièces de la galerie" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Nombre de produits", "min": 4, "max": 12, "step": 4, "default": 8 },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Tout voir" }
  ],
  "presets": [{ "name": "Collection mise en avant" }]
}
{% endschema %}
