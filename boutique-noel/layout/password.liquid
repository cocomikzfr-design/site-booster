<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_night }}">
    <meta name="robots" content="noindex">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }} – {{ 'password.title' | t }}</title>

    {% render 'meta-tags' %}

    <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin>

    {{ content_for_header }}

    {% render 'css-variables' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}

    <script>document.documentElement.classList.replace('no-js', 'js');</script>
    {%- if settings.snow_enabled -%}
      <script src="{{ 'snow.js' | asset_url }}" defer></script>
    {%- endif -%}
  </head>

  <body class="template-password scheme-night">
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    <main id="MainContent" class="password-layout" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <footer class="password-layout__footer">
      <a href="/admin" class="password-layout__admin text-muted">{{ 'password.admin_login' | t }}</a>
    </footer>

    {%- if settings.snow_enabled -%}
      <div class="snow-layer" aria-hidden="true" data-density="{{ settings.snow_density }}"></div>
    {%- endif -%}
  </body>
</html>
