{%- comment -%}
  Pictogramme SVG au trait fin (viewBox 24 × 24). Une icône inconnue ne rend rien.
  Accepte :
  - icon {String} nom de l'icône (obligatoire)
  - size {Number} taille en pixels (défaut : 24)
  - class {String} classe CSS supplémentaire (facultatif)
{%- endcomment -%}
{%- capture icon_paths -%}
  {%- case icon -%}
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/>
    {%- when 'cart' -%}
      <path d="M5 8h14l-1.2 11.1a2 2 0 0 1-2 1.9H8.2a2 2 0 0 1-2-1.9L5 8z"/><path d="M9 10V7a3 3 0 0 1 6 0v3"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8.5" r="3.5"/><path d="M5 20c1.2-3.5 3.8-5 7-5s5.8 1.5 7 5"/>
    {%- when 'chevron-left' -%}
      <path d="M15 5l-7 7 7 7"/>
    {%- when 'chevron-right' -%}
      <path d="M9 5l7 7-7 7"/>
    {%- when 'chevron-down' -%}
      <path d="M5 9l7 7 7-7"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'trash' -%}
      <path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/>
    {%- when 'check' -%}
      <path d="M5 12.5l4.5 4.5L19 7.5"/>
    {%- when 'play' -%}
      <path d="M8 5.5v13l10.5-6.5L8 5.5z"/>
    {%- when 'pause' -%}
      <path d="M9 5v14M15 5v14"/>
    {%- when 'zoom' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2M11 8.5v5M8.5 11h5"/>
    {%- when 'truck' -%}
      <path d="M2.5 6.5h11v9.5h-11zM13.5 9.5h4l3 3.5v3h-7"/><circle cx="6.5" cy="17.5" r="1.75"/><circle cx="17" cy="17.5" r="1.75"/>
    {%- when 'shield' -%}
      <path d="M12 3l7 3v5.5c0 4.4-3 8.1-7 9.5-4-1.4-7-5.1-7-9.5V6l7-3z"/><path d="M9 12l2 2 4-4"/>
    {%- when 'return' -%}
      <path d="M4 4v5h5"/><path d="M4.6 15a8 8 0 1 0 .9-7.5L4 9"/>
    {%- when 'mail' -%}
      <rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3.5 7l8.5 6 8.5-6"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
    {%- when 'gift' -%}
      <rect x="3.5" y="8" width="17" height="4" rx="1"/><path d="M5 12v8h14v-8M12 8v12"/><path d="M12 8C10.5 4.5 6.5 4.5 6.5 7S9.5 8 12 8zm0 0c1.5-3.5 5.5-3.5 5.5-1S14.5 8 12 8z"/>
    {%- when 'star' -%}
      <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>
    {%- when 'snowflake' -%}
      <path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9M9.5 4.5L12 7l2.5-2.5M9.5 19.5L12 17l2.5 2.5"/>
    {%- when 'bulb' -%}
      <path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.6.5 1 1.2 1 2v.2h5.2v-.2c0-.8.4-1.5 1-2A6 6 0 0 0 12 3z"/>
    {%- when 'plug' -%}
      <path d="M9 3v5M15 3v5M7 8h10v3a5 5 0 0 1-10 0V8zM12 16v5"/>
    {%- when 'ruler' -%}
      <path d="M3.5 15.5l12-12 5 5-12 12z"/><path d="M7 12l2 2M10 9l2 2M13 6l2 2"/>
    {%- when 'child' -%}
      <circle cx="12" cy="5.5" r="2.5"/><path d="M12 9v6M8 11l4-2 4 2M9.5 21l2.5-6 2.5 6"/>
    {%- when 'warning' -%}
      <path d="M12 4L2.8 19.5h18.4L12 4z"/><path d="M12 10v4.5M12 17.2v.3"/>
    {%- when 'share' -%}
      <circle cx="18" cy="5.5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="18.5" r="2.5"/><path d="M8.2 10.8l7.6-4.1M8.2 13.2l7.6 4.1"/>
    {%- when 'tiktok' -%}
      <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.4 2.6 2.2 4.4 5 4.6"/>
    {%- when 'instagram' -%}
      <rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17 7h.01"/>
    {%- when 'facebook' -%}
      <path d="M14.5 21v-7.5h3l.5-3.5h-3.5V8c0-1 .4-1.6 1.7-1.6H18V3.3c-.4 0-1.6-.3-3-.3-3 0-4.5 1.8-4.5 4.6V10H7.5v3.5h3V21"/>
    {%- when 'youtube' -%}
      <rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10 9.2v5.6l4.8-2.8L10 9.2z"/>
  {%- endcase -%}
{%- endcapture -%}
{%- if icon_paths != blank -%}
  {%- assign icon_size = size | default: 24 -%}
  <svg class="icon icon-{{ icon }}{% if class %} {{ class }}{% endif %}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {{- icon_paths -}}
  </svg>
{%- endif -%}
