{%- comment -%}
  Pagination accessible (précédent, numéros, suivant).
  Accepte :
  - paginate {Object} objet de pagination (obligatoire)
{%- endcomment -%}
{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'pagination.label' | t }}">
    <ul class="pagination__list" role="list">
      {%- if paginate.previous -%}
        <li>
          <a href="{{ paginate.previous.url }}" class="pagination__item" aria-label="{{ 'pagination.previous' | t }}">
            {%- render 'icon', icon: 'chevron-left', size: 20 -%}
          </a>
        </li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="pagination__item" aria-label="{{ 'pagination.page' | t: number: part.title }}">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="pagination__item is-current" aria-current="page" aria-label="{{ 'pagination.page' | t: number: part.title }}">{{ part.title }}</span>
          {%- else -%}
            <span class="pagination__item">{{ part.title }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}

      {%- if paginate.next -%}
        <li>
          <a href="{{ paginate.next.url }}" class="pagination__item" aria-label="{{ 'pagination.next' | t }}">
            {%- render 'icon', icon: 'chevron-right', size: 20 -%}
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
