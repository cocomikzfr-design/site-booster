{%- comment -%}
  Balises de description, Open Graph, Twitter et données structurées de la page.
  Accepte : rien (utilise les objets globaux).
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  endif
  assign raw_description = page_description | default: shop.description | default: shop.name
  assign description = raw_description | strip_html | strip_newlines | strip | truncate: 155
  assign home_url = request.origin | append: routes.root_url
-%}
<meta name="description" content="{{ description | escape }}">

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ description | escape }}">
{%- if page_image -%}
  {%- assign og_image_height = 1200 | divided_by: page_image.aspect_ratio | round -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ og_image_height }}">
{%- endif -%}
{%- if request.page_type == 'product' -%}
  {%- assign price_cents = product.price | modulo: 100 | prepend: '0' | slice: -2, 2 -%}
  <meta property="og:price:amount" content="{{ product.price | divided_by: 100 }}.{{ price_cents }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ description | escape }}">

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">{{ product | structured_data }}</script>
{%- endif -%}

{%- if request.page_type == 'index' -%}
  {%- liquid
    assign social_keys = 'social_tiktok_link,social_instagram_link,social_facebook_link,social_youtube_link' | split: ','
    assign social_joined = ''
    for key in social_keys
      if settings[key] != blank
        assign social_joined = social_joined | append: settings[key] | append: '|'
      endif
    endfor
    assign same_as = social_joined | split: '|'
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ home_url | json }},
      {%- if settings.logo != blank %}
        "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
      {%- endif %}
      "sameAs": {{ same_as | json }}
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ home_url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ request.origin | append: routes.search_url | append: '?q={search_term_string}' | json }},
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}
