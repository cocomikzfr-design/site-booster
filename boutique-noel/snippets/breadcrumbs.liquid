{%- comment -%}
  Fil d'Ariane des fiches produits et des collections, avec données structurées BreadcrumbList.
  Accepte : rien (utilise les objets globaux product et collection).
{%- endcomment -%}
{%- liquid
  assign is_product = false
  if request.page_type == 'product'
    assign is_product = true
  endif
  assign has_collection = false
  if collection and collection.handle != blank
    assign has_collection = true
  endif
  assign home_url = request.origin | append: routes.root_url
-%}
<nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
  <ol class="breadcrumbs__list" role="list">
    <li class="breadcrumbs__item">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
    </li>
    {%- if has_collection -%}
      <li class="breadcrumbs__item">
        {%- if is_product -%}
          <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
        {%- else -%}
          <span aria-current="page">{{ collection.title | escape }}</span>
        {%- endif -%}
      </li>
    {%- endif -%}
    {%- if is_product -%}
      <li class="breadcrumbs__item">
        <span aria-current="page">{{ product.title | escape }}</span>
      </li>
    {%- endif -%}
  </ol>
</nav>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'general.home' | t | json }},
        "item": {{ home_url | json }}
      }
      {%- if has_collection -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": {{ request.origin | append: collection.url | json }}
        }
      {%- endif -%}
      {%- if is_product -%}
        ,{
          "@type": "ListItem",
          "position": {% if has_collection %}3{% else %}2{% endif %},
          "name": {{ product.title | json }},
          "item": {{ request.origin | append: product.url | json }}
        }
      {%- endif %}
    ]
  }
</script>
