{%- liquid
  assign poster = section.settings.poster
  if poster == blank and section.settings.video != blank
    assign poster = section.settings.video.preview_image
  endif
  assign mobile_poster = section.settings.mobile_poster
  assign overlay = section.settings.overlay_opacity | divided_by: 100.0
  assign video_id = 'HeroVideo-' | append: section.id
  assign primary_link = section.settings.button_link | default: routes.all_products_collection_url
  assign secondary_link = section.settings.secondary_link | default: routes.all_products_collection_url
-%}
{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    --overlay-opacity: {{ overlay }};
  }
{%- endstyle -%}

<div class="section hero hero--{{ section.settings.height_mobile }} section-{{ section.id }} scheme-{{ section.settings.color_scheme }}">
  <div class="hero__media">
    {%- if poster != blank -%}
      <picture class="hero__poster">
        {%- if mobile_poster != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ mobile_poster | image_url: width: 750 }} 750w, {{ mobile_poster | image_url: width: 1100 }} 1100w, {{ mobile_poster | image_url: width: 1500 }} 1500w"
            sizes="100vw"
            width="{{ mobile_poster.width }}"
            height="{{ mobile_poster.height }}"
          >
        {%- endif -%}
        {{ poster | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1800, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: '', class: 'hero__image' }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}

    {%- if section.settings.video != blank -%}
      <div class="hero__video" id="{{ video_id }}" data-autoplay-video>
        {{ section.settings.video | video_tag: muted: true, loop: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1600x' }}
      </div>
    {%- endif -%}

    <div class="hero__overlay"></div>
    <div class="hero__stars" aria-hidden="true">
      {%- for i in (1..14) -%}
        {%- liquid
          assign star_x = i | times: 37 | modulo: 97
          assign star_y = i | times: 23 | modulo: 55 | plus: 4
          assign star_delay = i | times: 0.37 | modulo: 2.6 | round: 2
        -%}
        <span class="hero__star" style="--x: {{ star_x }}%; --y: {{ star_y }}%; --delay: {{ star_delay }}s;"></span>
      {%- endfor -%}
    </div>
  </div>

  <div class="hero__content page-width">
    <div class="hero__text stack">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="hero__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="hero__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank or section.settings.secondary_label != blank -%}
        <div class="hero__buttons">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ primary_link }}" class="button button--primary">{{ section.settings.button_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.secondary_label != blank -%}
            <a href="{{ secondary_link }}" class="button button--secondary">{{ section.settings.secondary_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_countdown -%}
        {%- capture hero_countdown -%}{% render 'deadline-countdown', style: 'blocks' %}{%- endcapture -%}
        {%- if hero_countdown != blank -%}
          <div class="hero__countdown">{{ hero_countdown }}</div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.video != blank -%}
    <button
      type="button"
      class="icon-button media-toggle play-toggle"
      data-video-toggle
      aria-controls="{{ video_id }}"
      data-label-pause="{{ 'accessibility.pause_video' | t }}"
      data-label-play="{{ 'accessibility.play_video' | t }}"
      aria-label="{{ 'accessibility.pause_video' | t }}"
    >
      {%- render 'icon', icon: 'pause', size: 20 -%}
      {%- render 'icon', icon: 'play', size: 20 -%}
    </button>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Vidéo d'accueil",
  "class": "section-hero",
  "settings": [
    {
      "type": "header",
      "content": "Vidéo et images"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Vidéo",
      "info": "Boucle muette de 6 à 12 secondes, moins de 10 Mo. Montrez l'effet réel du produit."
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Image d'attente",
      "info": "Affichée avant la vidéo et pour les visiteurs qui réduisent les animations. 2048 px de large au maximum."
    },
    {
      "type": "image_picker",
      "id": "mobile_poster",
      "label": "Image d'attente pour mobile",
      "info": "Facultatif : image verticale."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Assombrissement de la vidéo",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "Hauteur sur mobile",
      "options": [
        { "value": "small", "label": "Petite" },
        { "value": "medium", "label": "Moyenne" },
        { "value": "full", "label": "Plein écran" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Textes"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Collection Noël 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "info": "C'est le titre principal (h1) de la page d'accueil.",
      "default": "Votre façade illuminée en 5 minutes"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Projecteurs et guirlandes LED prêts à brancher. Livraison offerte."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton principal",
      "default": "Découvrir le pack"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton principal"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Texte du bouton secondaire",
      "default": "Voir toutes les décorations"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Lien du bouton secondaire"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Afficher le compte à rebours de Noël",
      "default": true
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleurs",
      "options": [
        { "value": "night", "label": "Nuit" },
        { "value": "night-soft", "label": "Nuit douce" },
        { "value": "cream", "label": "Crème" },
        { "value": "white", "label": "Blanc" }
      ],
      "default": "night"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge en haut",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge en bas",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Vidéo d'accueil"
    }
  ]
}
{% endschema %}
