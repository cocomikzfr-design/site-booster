{%- liquid
  assign grid_collection = section.settings.collection
  assign limit = section.settings.products_to_show
  assign cols_desktop = section.settings.columns_desktop
  assign cols_mobile = section.settings.columns_mobile | plus: 0
  assign highlight = section.settings.highlight_product | default: settings.pack_product
  assign most_chosen = 'products.most_chosen' | t
  assign card_sizes = '(min-width: 990px) calc((min(100vw, 1280px) - 80px) / ' | append: cols_desktop | append: '), (min-width: 750px) calc((100vw - 72px) / 2), calc((100vw - 48px) / ' | append: cols_mobile | append: ')'
-%}
{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- if grid_collection.products_count > 0 or request.design_mode -%}
  <div class="section product-grid section-{{ section.id }} scheme-{{ section.settings.color_scheme }}">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <div class="section__header section__header--center">
          <h2>{{ section.settings.heading | escape }}</h2>
        </div>
      {%- endif -%}

      <ul class="grid" role="list" style="--grid-cols-mobile: {{ cols_mobile }}; --grid-cols-tablet: 2; --grid-cols-desktop: {{ cols_desktop }};">
        {%- if grid_collection.products_count > 0 -%}
          {%- for product in grid_collection.products limit: limit -%}
            {%- liquid
              assign badge = ''
              if highlight != blank and product.id == highlight.id
                assign badge = most_chosen
              endif
            -%}
            <li class="product-grid__item reveal">
              {% render 'product-card', product: product, section_id: section.id, badge_text: badge, show_badge: true, image_sizes: card_sizes %}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <li class="product-grid__item">
              <article class="card product-card">
                <div class="card__media card__media--{{ settings.card_image_ratio }}">
                  {%- assign placeholder_name = 'product-' | append: i -%}
                  {{ placeholder_name | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
                <div class="card__body">
                  <h3 class="card__title">{{ 'general.placeholder_product' | t }}</h3>
                  <p class="price"><span class="price__current">{{ 2990 | money }}</span></p>
                </div>
              </article>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>

      {%- if section.settings.show_view_all and grid_collection.products_count > limit -%}
        <div class="section__footer">
          <a href="{{ grid_collection.url }}" class="button button--secondary">{{ 'general.view_all' | t }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Grille de produits",
  "class": "section-product-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Toutes nos décorations lumineuses"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Nombre de produits",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Colonnes sur ordinateur",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Colonnes sur mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Bouton « Tout voir » si la collection contient plus de produits",
      "default": true
    },
    {
      "type": "product",
      "id": "highlight_product",
      "label": "Produit avec l'étiquette « Le plus choisi »",
      "info": "Laissez vide pour utiliser le produit pack des Paramètres du thème."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleurs",
      "options": [
        { "value": "night", "label": "Nuit" },
        { "value": "night-soft", "label": "Nuit douce" },
        { "value": "cream", "label": "Crème" },
        { "value": "white", "label": "Blanc" }
      ],
      "default": "white"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge en haut",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge en bas",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Grille de produits"
    }
  ]
}
{% endschema %}
