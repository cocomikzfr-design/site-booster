{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="section faq section-{{ section.id }} scheme-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}
      <h2 class="faq__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="faq__list">
      {%- for block in section.blocks -%}
        {%- if block.settings.christmas_only and settings.season_mode != 'christmas' -%}
          {%- continue -%}
        {%- endif -%}
        <details
          class="accordion"
          {% if section.settings.open_first and forloop.first %}
            open
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <summary class="accordion__summary">
            <span class="accordion__title">{{ block.settings.question | escape }}</span>
            {%- render 'icon', icon: 'plus', size: 20, class: 'accordion__icon' -%}
          </summary>
          <div class="accordion__content rte">
            {{- block.settings.answer -}}
            {%- if block.settings.christmas_note -%}
              {% render 'christmas-note' %}
            {%- endif -%}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- capture faq_entities -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.christmas_only and settings.season_mode != 'christmas' -%}
      {%- continue -%}
    {%- endif -%}
    {%- if block.settings.question != blank -%}
      {"@type": "Question", "name": {{ block.settings.question | strip | json }}, "acceptedAnswer": {"@type": "Answer", "text": {{ block.settings.answer | strip_html | strip | json }}}},
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if faq_entities != blank -%}
  <script type="application/ld+json">
    {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{{ faq_entities | strip | remove_last: ',' }}]}
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Questions fréquentes",
  "class": "section-faq",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Questions fréquentes"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Ouvrir la première question",
      "default": false
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleurs",
      "options": [
        { "value": "night", "label": "Nuit" },
        { "value": "night-soft", "label": "Nuit douce" },
        { "value": "cream", "label": "Crème" },
        { "value": "white", "label": "Blanc" }
      ],
      "default": "white"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge en haut",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge en bas",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Quand vais-je recevoir ma commande ?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Réponse",
          "default": "<p>Comptez 7 à 12 jours après votre commande. Vous recevez un numéro de suivi par e-mail dès l'expédition.</p>"
        },
        {
          "type": "checkbox",
          "id": "christmas_note",
          "label": "Ajouter la phrase sur la date limite de Noël",
          "info": "Construite à partir des Paramètres du thème > Saison de Noël. Masquée hors saison.",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "christmas_only",
          "label": "Afficher cette question uniquement pendant la saison de Noël",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Questions fréquentes",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Quand vais-je recevoir ma commande ?",
            "answer": "<p>Comptez 7 à 12 jours après votre commande. Vous recevez un numéro de suivi par e-mail dès l'expédition.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Puis-je encore recevoir avant Noël ?",
            "answer": "<p>Oui, si vous commandez au plus tard le 8 décembre. Après cette date, la livraison peut arriver après Noël.</p>",
            "christmas_only": true
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "La livraison est-elle payante ?",
            "answer": "<p>Non, la livraison est offerte en France et en Belgique.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Et si le produit ne me plaît pas ?",
            "answer": "<p>Vous disposez de 14 jours après réception pour changer d'avis. Les conditions de retour sont détaillées dans notre politique de remboursement.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Les produits fonctionnent-ils à l'extérieur ?",
            "answer": "<p>Chaque fiche produit indique où l'utiliser. [À VÉRIFIER : indices de protection de chaque produit]</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Comment vous contacter ?",
            "answer": "<p>Par e-mail via la page Contact. Nous répondons sous 24 h ouvrées.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
