{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="section section-{{ section.id }} scheme-{{ section.settings.color_scheme }}">
  <div class="page-width{% if section.settings.width == 'narrow' %} page-width--narrow{% endif %}">
    <div class="rich-text__inner stack rich-text--{{ section.settings.alignment }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            {%- if block.settings.size == 'h3' -%}
              <h3 {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h3>
            {%- else -%}
              <h2 {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
          {%- when 'text' -%}
            <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            {%- if block.settings.label != blank and block.settings.link != blank -%}
              <p {{ block.shopify_attributes }}>
                <a href="{{ block.settings.link }}" class="button button--{{ block.settings.style }}">{{ block.settings.label | escape }}</a>
              </p>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Texte libre",
  "class": "section-rich-text",
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "Largeur",
      "options": [
        { "value": "narrow", "label": "Étroite" },
        { "value": "normal", "label": "Normale" }
      ],
      "default": "narrow"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignement",
      "options": [
        { "value": "left", "label": "À gauche" },
        { "value": "center", "label": "Centré" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleurs",
      "options": [
        { "value": "night", "label": "Nuit" },
        { "value": "night-soft", "label": "Nuit douce" },
        { "value": "cream", "label": "Crème" },
        { "value": "white", "label": "Blanc" }
      ],
      "default": "cream"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge en haut",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge en bas",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Titre",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titre",
          "default": "Une boutique belge de décorations lumineuses"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Niveau du titre",
          "options": [
            { "value": "h2", "label": "Grand (h2)" },
            { "value": "h3", "label": "Moyen (h3)" }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "text",
      "name": "Texte",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte",
          "default": "<p>Des décorations simples à installer, pour illuminer votre maison sans échelle ni électricien.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Bouton",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Texte du bouton",
          "default": "Voir les décorations"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "primary", "label": "Rouge (achat)" },
            { "value": "secondary", "label": "Contour doré" }
          ],
          "default": "secondary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Texte libre",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
