{{ 'section-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign terms = search.terms | escape
-%}
{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- paginate search.results by 12 -%}
  <div class="section main-search section-{{ section.id }} scheme-{{ section.settings.color_scheme }}">
    <div class="page-width">
      <div class="section__header section__header--center">
        <h1>
          {%- if search.performed and terms != blank -%}
            {{ 'search.results_for' | t: terms: terms }}
          {%- else -%}
            {{ 'search.title' | t }}
          {%- endif -%}
        </h1>
      </div>

      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
        <label for="SearchInput-{{ section.id }}" class="visually-hidden">{{ 'general.search' | t }}</label>
        <input
          type="search"
          id="SearchInput-{{ section.id }}"
          name="q"
          value="{{ terms }}"
          class="field__input search-form__input"
          placeholder="{{ 'general.search_placeholder' | t }}"
          autocomplete="off"
        >
        <input type="hidden" name="type" value="product">
        <button type="submit" class="button button--primary search-form__button">
          {%- render 'icon', icon: 'search', size: 20 -%}
          <span class="visually-hidden">{{ 'search.submit' | t }}</span>
        </button>
      </form>

      {%- if search.performed -%}
        <p class="search-results__count text-muted" role="status">{{ 'search.results_count' | t: count: search.results_count }}</p>

        {%- if search.results_count == 0 -%}
          <p class="search-results__empty">{{ 'search.no_results' | t: terms: terms }}</p>
        {%- else -%}
          <ul class="grid search-results" role="list" style="--grid-cols-mobile: 2; --grid-cols-tablet: 3; --grid-cols-desktop: 4;">
            {%- for item in search.results -%}
              <li class="reveal">
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', product: item, section_id: section.id, heading_level: 'h2', image_sizes: '(min-width: 990px) 25vw, 50vw' %}
                {%- else -%}
                  <article class="card search-card">
                    <div class="card__body">
                      <h2 class="card__title"><a href="{{ item.url }}" class="card__link">{{ item.title | escape }}</a></h2>
                      <p class="text-muted text-small">{{ item.content | strip_html | truncatewords: 20 }}</p>
                    </div>
                  </article>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Résultats de recherche",
  "class": "section-main-search",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleurs",
      "options": [
        { "value": "night", "label": "Nuit" },
        { "value": "night-soft", "label": "Nuit douce" },
        { "value": "cream", "label": "Crème" },
        { "value": "white", "label": "Blanc" }
      ],
      "default": "white"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge en haut",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge en bas",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ]
}
{% endschema %}
