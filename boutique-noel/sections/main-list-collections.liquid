{{ 'section-collection.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- paginate collections by 12 -%}
  <div class="section section-{{ section.id }} scheme-{{ section.settings.color_scheme }}">
    <div class="page-width">
      <div class="section__header section__header--center">
        <h1>{{ section.settings.heading | escape }}</h1>
      </div>

      <ul class="grid" role="list" style="--grid-cols-mobile: 2; --grid-cols-tablet: 3; --grid-cols-desktop: 3;">
        {%- for item in collections -%}
          {%- assign cover = item.featured_image | default: item.products.first.featured_media.preview_image -%}
          <li class="reveal">
            <a href="{{ item.url }}" class="card collection-card">
              <div class="card__media card__media--portrait">
                {% render 'responsive-image',
                  image: cover,
                  sizes: '(min-width: 990px) 33vw, 50vw',
                  widths: '360, 540, 720, 900',
                  decorative: true,
                  placeholder: 'collection-1'
                %}
              </div>
              <div class="card__body">
                <h2 class="card__title">{{ item.title | escape }}</h2>
                <p class="text-muted text-small">{{ 'collection.products_count' | t: count: item.products_count }}</p>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {% render 'pagination', paginate: paginate %}
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Liste des collections",
  "class": "section-main-list-collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Nos collections"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleurs",
      "options": [
        { "value": "night", "label": "Nuit" },
        { "value": "night-soft", "label": "Nuit douce" },
        { "value": "cream", "label": "Crème" },
        { "value": "white", "label": "Blanc" }
      ],
      "default": "white"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge en haut",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge en bas",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ]
}
{% endschema %}
