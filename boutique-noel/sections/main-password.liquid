{%- liquid
  assign newsletter_id = 'PasswordNewsletter-' | append: section.id
-%}
<div class="password stack">
  {%- if settings.logo != blank -%}
    {{ settings.logo | image_url: width: 480 | image_tag: widths: '240, 360, 480', sizes: '240px', loading: 'eager', alt: shop.name, class: 'password__logo' }}
  {%- else -%}
    <p class="h3">{{ shop.name | escape }}</p>
  {%- endif -%}

  <h1>{{ 'password.title' | t }}</h1>
  {%- if shop.password_message != blank -%}
    <p class="text-muted">{{ shop.password_message | escape }}</p>
  {%- endif -%}

  {%- if section.settings.show_newsletter -%}
    {%- form 'customer', id: newsletter_id, class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, password">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">
          {%- render 'icon', icon: 'check', size: 20 -%}
          {{ 'newsletter.success' | t }}
        </p>
      {%- else -%}
        <div class="field{% if form.errors %} field--error{% endif %}">
          <label for="{{ newsletter_id }}-email" class="field__label">{{ 'password.newsletter_heading' | t }}</label>
          <div class="newsletter__row">
            <input
              type="email"
              id="{{ newsletter_id }}-email"
              name="contact[email]"
              class="field__input"
              autocomplete="email"
              placeholder="{{ 'newsletter.placeholder' | t }}"
              required
            >
            <button type="submit" class="button button--primary">{{ 'newsletter.submit' | t }}</button>
          </div>
          {%- if form.errors -%}
            <p class="field__error" role="alert">{{ 'newsletter.error' | t }}</p>
          {%- endif -%}
        </div>
        <p class="newsletter__consent text-muted">{{ 'newsletter.consent' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  {%- endif -%}

  {%- form 'storefront_password', class: 'password__login' -%}
    <details class="password__details"{% if form.errors %} open{% endif %}>
      <summary class="button button--ghost">{{ 'password.enter_password' | t }}</summary>
      <div class="password__form stack">
        <div class="field{% if form.errors %} field--error{% endif %}">
          <label for="Password" class="field__label">{{ 'password.password_label' | t }}</label>
          <input
            type="password"
            id="Password"
            name="password"
            class="field__input"
            autocomplete="current-password"
            {% if form.errors %}
              aria-invalid="true" aria-describedby="PasswordError"
            {% endif %}
          >
          {%- if form.errors -%}
            <p id="PasswordError" class="field__error" role="alert">{{ 'password.error' | t }}</p>
          {%- endif -%}
        </div>
        <button type="submit" class="button button--secondary">{{ 'password.submit' | t }}</button>
      </div>
    </details>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Page d'attente",
  "class": "section-main-password",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Formulaire d'inscription à la newsletter",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Le message affiché se modifie dans Boutique en ligne > Préférences > Protection par mot de passe."
    }
  ]
}
{% endschema %}
