{%- liquid
  assign form_id = 'NewsletterForm-' | append: section.id
  assign email_id = 'NewsletterEmail-' | append: section.id
  assign error_id = 'NewsletterError-' | append: section.id
-%}
{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="section newsletter section-{{ section.id }} scheme-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--narrow newsletter__inner stack text-center">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.incentive_text != blank -%}
      <p class="newsletter__incentive">{{ section.settings.incentive_text | escape }}</p>
    {%- endif -%}

    {%- form 'customer', id: form_id, class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">
          {%- render 'icon', icon: 'check', size: 20 -%}
          {{ 'newsletter.success' | t }}
        </p>
      {%- else -%}
        <div class="field{% if form.errors %} field--error{% endif %}">
          <label for="{{ email_id }}" class="field__label">{{ 'newsletter.label' | t }}</label>
          <div class="newsletter__row">
            <input
              type="email"
              id="{{ email_id }}"
              name="contact[email]"
              class="field__input"
              autocomplete="email"
              placeholder="{{ 'newsletter.placeholder' | t }}"
              required
              {% if form.errors %}
                aria-invalid="true" aria-describedby="{{ error_id }}"
              {% endif %}
            >
            <button type="submit" class="button button--primary">{{ 'newsletter.submit' | t }}</button>
          </div>
          {%- if form.errors -%}
            <p id="{{ error_id }}" class="field__error" role="alert">{{ 'newsletter.error' | t }}</p>
          {%- endif -%}
        </div>
        <p class="newsletter__consent text-muted">{{ 'newsletter.consent' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Les idées lumineuses de la saison"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Nouveautés et conseils de décoration, au maximum un e-mail par semaine.</p>"
    },
    {
      "type": "text",
      "id": "incentive_text",
      "label": "Avantage proposé",
      "info": "Facultatif. N'annoncez un code promo que s'il existe vraiment dans Remises."
    },
    {
      "type": "paragraph",
      "content": "Les inscrits apparaissent dans Clients, avec le tag « newsletter »."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleurs",
      "options": [
        { "value": "night", "label": "Nuit" },
        { "value": "night-soft", "label": "Nuit douce" },
        { "value": "cream", "label": "Crème" },
        { "value": "white", "label": "Blanc" }
      ],
      "default": "night-soft"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge en haut",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge en bas",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
