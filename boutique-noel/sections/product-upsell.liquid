{%- liquid
  assign upsell_count = 0
  for upsell_product in section.settings.products
    if upsell_product.id != product.id
      assign upsell_count = upsell_count | plus: 1
    endif
  endfor
-%}
{%- if upsell_count > 0 -%}
  {%- style -%}
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  {%- endstyle -%}

  <div class="section product-upsell section-{{ section.id }} scheme-{{ section.settings.color_scheme }}">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <div class="section__header section__header--center">
          <h2>{{ section.settings.heading | escape }}</h2>
        </div>
      {%- endif -%}
      <ul class="grid" role="list" style="--grid-cols-mobile: 2; --grid-cols-tablet: 3; --grid-cols-desktop: 3;">
        {%- for upsell_product in section.settings.products -%}
          {%- unless upsell_product.id == product.id -%}
            <li class="reveal">
              {% render 'product-card', product: upsell_product, section_id: section.id, image_sizes: '(min-width: 750px) 33vw, 50vw' %}
            </li>
          {%- endunless -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Produits complémentaires",
  "class": "section-product-upsell",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Complétez votre décoration"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Produits",
      "info": "Le produit de la fiche en cours est retiré automatiquement.",
      "limit": 3
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleurs",
      "options": [
        { "value": "night", "label": "Nuit" },
        { "value": "night-soft", "label": "Nuit douce" },
        { "value": "cream", "label": "Crème" },
        { "value": "white", "label": "Blanc" }
      ],
      "default": "white"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge en haut",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge en bas",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Produits complémentaires"
    }
  ]
}
{% endschema %}
