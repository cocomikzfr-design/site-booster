{%- comment -%}
  Carte stylisée (illustration, pas une vraie carte) avec épingle animée.
  - street, city : textes affichés sur la carte
{%- endcomment -%}
<div class="map holo-card"{% if settings.enable_holo %} data-tilt data-tilt-max="4"{% endif %}>
  <svg class="map__svg" viewBox="0 0 600 460" role="img" aria-label="{{ 'sections.store.map_label' | t: shop: shop.name, address: settings.store_address | escape }}">
    <defs>
      <pattern id="map-grid" width="24" height="24" patternUnits="userSpaceOnUse"><path d="M24 0H0v24" fill="none" stroke="rgba(74,44,29,.08)" stroke-width="1"/></pattern>
    </defs>
    <rect width="600" height="460" fill="#F7E8D6"/>
    <rect width="600" height="460" fill="url(#map-grid)"/>
    <path d="M420 40c60-10 140 10 160 60s-30 90-90 80-110-20-120-60 0-70 50-80Z" fill="#CFE3C0"/>
    <path d="M40 330c40-20 110-10 130 30s-10 70-60 70-90-10-100-40 0-50 30-60Z" fill="#CFE3C0"/>
    <g fill="#EAD3BA">
      <rect x="60" y="60" width="140" height="90" rx="14"/><rect x="230" y="40" width="120" height="110" rx="14"/>
      <rect x="60" y="190" width="110" height="100" rx="14"/><rect x="380" y="230" width="170" height="90" rx="14"/>
      <rect x="230" y="320" width="130" height="110" rx="14"/><rect x="400" y="350" width="150" height="80" rx="14"/>
    </g>
    <g fill="none" stroke="#FFF6EC" stroke-linecap="round">
      <path d="M0 175C150 170 260 190 360 200s160 10 240 0" stroke-width="22"/>
      <path d="M210 0c5 120 15 230 0 460" stroke-width="18"/>
      <path d="M370 0c-10 90 0 170 10 200s0 160-20 260" stroke-width="14"/>
      <path d="M0 305c120 0 250-5 380 10s170 0 220-5" stroke-width="12"/>
    </g>
    <g fill="#8A6650" font-family="Inter, sans-serif" font-size="13" font-weight="600" letter-spacing=".04em">
      <text x="26" y="168">{{ street }}</text>
      <text x="440" y="300">{{ city }}</text>
    </g>
    <path class="map__route" d="M40 430C120 400 150 330 210 300s20-110 70-125" fill="none" stroke="#8B5CF6" stroke-width="4" stroke-dasharray="2 10" stroke-linecap="round"/>
  </svg>
  <div class="map__pin" style="--x:47%;--y:38%">
    <span class="map__pulse"></span>
    <span class="map__marker">{% render 'icon', name: 'pin' %}</span>
    <span class="map__label glass">{{ shop.name }}<small>{{ settings.store_address }}</small></span>
  </div>
</div>
