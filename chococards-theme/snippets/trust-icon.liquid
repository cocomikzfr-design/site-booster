{%- comment -%} Icône animée de la réassurance. - name : truck | shield | lock | store | chat | star | gift | card {%- endcomment -%}
<span class="trust__icon trust__icon--{{ name }}">
  {%- case name -%}
    {%- when 'truck' -%}
      <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M4 14h24v18H4zM28 20h8l6 6v6H28z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><circle cx="12" cy="34" r="4" fill="var(--choco-700)" stroke="currentColor" stroke-width="2.5"/><circle cx="35" cy="34" r="4" fill="var(--choco-700)" stroke="currentColor" stroke-width="2.5"/><path class="t-speed" d="M0 20h-6M0 25h-9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
    {%- when 'shield' -%}
      <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M24 4 8 10v12c0 10 7 18 16 22 9-4 16-12 16-22V10L24 4Z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path class="t-check" d="m16 24 6 6 11-12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {%- when 'lock' -%}
      <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path class="t-shackle" d="M15 21v-6a9 9 0 0 1 18 0v6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><rect x="10" y="21" width="28" height="21" rx="5" fill="none" stroke="currentColor" stroke-width="2.5"/><circle cx="24" cy="31" r="2.6" fill="currentColor"/></svg>
    {%- when 'store' -%}
      <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path class="t-awning" d="M6 18 9 8h30l3 10a5 5 0 0 1-9 2 5 5 0 0 1-9 0 5 5 0 0 1-9 0 5 5 0 0 1-9-2Z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path d="M9 22v18h30V22M20 40v-9h8v9" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/></svg>
    {%- when 'chat' -%}
      <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M8 10h32v22H22l-8 7v-7H8z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><g class="t-dots" fill="currentColor"><circle cx="17" cy="21" r="2.2"/><circle cx="24" cy="21" r="2.2"/><circle cx="31" cy="21" r="2.2"/></g></svg>
    {%- else -%}
      {%- render 'icon', name: name -%}
  {%- endcase -%}
</span>
