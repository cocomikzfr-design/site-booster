{%- comment -%} Champs d'adresse client. - form, id {%- endcomment -%}
<div class="contact__row">
  <div class="field"><label for="AddressFirstName-{{ id }}">{{ 'customer.first_name' | t }}</label><input id="AddressFirstName-{{ id }}" type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></div>
  <div class="field"><label for="AddressLastName-{{ id }}">{{ 'customer.last_name' | t }}</label><input id="AddressLastName-{{ id }}" type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></div>
</div>
<div class="field"><label for="AddressCompany-{{ id }}">{{ 'customer.company' | t }}</label><input id="AddressCompany-{{ id }}" type="text" name="address[company]" value="{{ form.company }}" autocomplete="organization"></div>
<div class="field"><label for="AddressAddress1-{{ id }}">{{ 'customer.address1' | t }}</label><input id="AddressAddress1-{{ id }}" type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></div>
<div class="field"><label for="AddressAddress2-{{ id }}">{{ 'customer.address2' | t }}</label><input id="AddressAddress2-{{ id }}" type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></div>
<div class="contact__row">
  <div class="field"><label for="AddressZip-{{ id }}">{{ 'customer.zip' | t }}</label><input id="AddressZip-{{ id }}" type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></div>
  <div class="field"><label for="AddressCity-{{ id }}">{{ 'customer.city' | t }}</label><input id="AddressCity-{{ id }}" type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></div>
</div>
<div class="field">
  <label for="AddressCountry-{{ id }}">{{ 'customer.country' | t }}</label>
  <select id="AddressCountry-{{ id }}" name="address[country]" data-default="{{ form.country }}" autocomplete="country">{{ all_country_option_tags }}</select>
</div>
<div class="field"><label for="AddressPhone-{{ id }}">{{ 'customer.phone' | t }}</label><input id="AddressPhone-{{ id }}" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></div>
<label class="checkbox"><input type="checkbox" name="address[default]" value="1"{% if form.set_as_default_checkbox %} checked{% endif %}>{{ 'customer.set_default' | t }}</label>
