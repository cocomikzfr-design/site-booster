{{ 'templates.css' | asset_url | stylesheet_tag }}
<div class="page-hero">
  <div class="container page-hero__inner">
    <p><a class="link-arrow" href="{{ routes.account_url }}">{% render 'icon', name: 'arrow-left' %}{{ 'customer.back_to_account' | t }}</a></p>
    <h1 class="page-hero__title">{{ 'customer.order' | t }} {{ order.name }}</h1>
    <p>{{ order.created_at | time_tag: format: 'date_at_time' }}</p>
    {%- if order.cancelled -%}<p class="form-message form-message--error">{{ 'customer.cancelled' | t: date: order.cancelled_at }}</p>{%- endif -%}
  </div>
</div>
<section class="account container">
  <div class="account__grid">
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th scope="col">{{ 'customer.product' | t }}</th><th scope="col">{{ 'customer.quantity' | t }}</th><th scope="col">{{ 'customer.total' | t }}</th></tr></thead>
        <tbody>
          {%- for line_item in order.line_items -%}
            <tr>
              <td>{{ line_item.title | link_to: line_item.product.url }}{% if line_item.fulfillment %}<br><small>{{ line_item.fulfillment.created_at | time_tag: format: 'date' }}{% if line_item.fulfillment.tracking_url %} · <a href="{{ line_item.fulfillment.tracking_url }}">{{ 'customer.track' | t }}</a>{% endif %}</small>{% endif %}</td>
              <td>{{ line_item.quantity }}</td>
              <td>{{ line_item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot>
          <tr><th scope="row" colspan="2">{{ 'customer.subtotal' | t }}</th><td>{{ order.line_items_subtotal_price | money }}</td></tr>
          {%- for shipping_method in order.shipping_methods -%}
            <tr><th scope="row" colspan="2">{{ 'customer.shipping' | t }} ({{ shipping_method.title }})</th><td>{{ shipping_method.price | money }}</td></tr>
          {%- endfor -%}
          {%- for tax_line in order.tax_lines -%}
            <tr><th scope="row" colspan="2">{{ tax_line.title }} ({{ tax_line.rate_percentage }} %)</th><td>{{ tax_line.price | money }}</td></tr>
          {%- endfor -%}
          <tr><th scope="row" colspan="2">{{ 'customer.total' | t }}</th><td>{{ order.total_net_amount | money_with_currency }}</td></tr>
        </tfoot>
      </table>
    </div>
    <aside class="address-grid">
      <div class="address-card"><h2>{{ 'customer.billing_address' | t }}</h2>{{ order.billing_address | format_address }}</div>
      <div class="address-card"><h2>{{ 'customer.shipping_address' | t }}</h2>{{ order.shipping_address | format_address }}</div>
    </aside>
  </div>
</section>

{% schema %}
{ "name": "Commande", "settings": [] }
{% endschema %}
