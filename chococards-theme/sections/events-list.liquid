{%- comment -%}
  Tournois & événements en boutique.
  Source : metaobjects « Événement » (type evenement : date, heure, jeu, titre, prix,
  produit = produit-ticket pour l'inscription, lien). Sinon, blocs de la section.
  Tri par date, événements passés masqués.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign anchor = s.anchor | default: section.id | handleize
  assign deep = false
  if s.scheme == 'light'
    assign deep = true
  endif
  assign title_id = 'Title-' | append: section.id
  assign top_link = s.link
  if top_link == blank and s.page_handle != blank
    assign top_link = pages[s.page_handle].url
  endif
  if top_link == request.path
    assign top_link = blank
  endif
  assign definition = shop.metaobjects[s.metaobject_type]
  assign entries = definition.values
  assign today = 'now' | date: '%Y%m%d' | plus: 0
  assign keys = ''
  assign source = 'blocks'
  if s.use_metaobjects and definition.values_count > 0
    assign source = 'metaobjects'
    for entry in entries
      assign d = entry.date.value | date: '%Y%m%d'
      assign dn = d | plus: 0
      if dn >= today and dn > 0
        assign keys = keys | append: d | append: '-' | append: forloop.index0 | append: ','
      endif
    endfor
  else
    for block in section.blocks
      assign d = block.settings.date | date: '%Y%m%d'
      assign dn = d | plus: 0
      if dn >= today and dn > 0
        assign keys = keys | append: d | append: '-' | append: forloop.index0 | append: ','
      endif
    endfor
  endif
  assign sorted = keys | split: ',' | sort
-%}
<section class="section events{% if deep %} panel panel--light{% endif %}" id="{{ anchor }}" style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px" aria-labelledby="{{ title_id }}">
  <div class="container">
    {%- capture extra -%}
      {%- if s.link_label != blank and top_link != blank -%}<a class="link-arrow" href="{{ top_link }}">{{ s.link_label }}{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
    {%- endcapture -%}
    {% render 'section-heading', eyebrow: s.eyebrow, heading: s.heading, heading_holo: s.heading_holo, deep: deep, align: 'split', extra: extra, id: title_id %}

    {%- if sorted.size > 0 -%}
      <div class="event-grid" data-reveal-stagger>
        {%- for key in sorted limit: s.limit -%}
          {%- assign idx = key | split: '-' | last | plus: 0 -%}
          {%- if source == 'metaobjects' -%}
            {%- for entry in entries -%}
              {%- if forloop.index0 == idx -%}
                {%- liquid
                  assign ticket = entry.produit.value
                  assign price = ''
                  if entry.prix.value != blank
                    assign price = entry.prix.value | times: 100 | money_without_trailing_zeros
                  elsif ticket != blank
                    assign price = ticket.price | money_without_trailing_zeros
                  endif
                  assign href = ticket.url | default: entry.lien.value | default: s.fallback_link
                -%}
                {% render 'event-card', date: entry.date.value, heure: entry.heure.value, jeu: entry.jeu.value, titre: entry.titre.value, prix: price, lien: href, cta: s.cta_label %}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              {%- if forloop.index0 == idx -%}
                {%- liquid
                  assign b = block.settings
                  assign href = b.product.url | default: b.link | default: s.fallback_link
                -%}
                {% render 'event-card', date: b.date, heure: b.time, jeu: b.game, titre: b.title, prix: b.price, lien: href, cta: s.cta_label, attrs: block.shopify_attributes %}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="section-lead">{{ 'sections.events.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Tournois et événements",
  "class": "section-events",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "En boutique" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Tournois &" },
    { "type": "text", "id": "heading_holo", "label": "Fin du titre (holographique)", "default": "événements" },
    { "type": "text", "id": "link_label", "label": "Lien en haut à droite", "default": "Tous les tournois" },
    { "type": "url", "id": "link", "label": "Lien" },
    { "type": "text", "id": "page_handle", "label": "Ou identifiant de la page (si lien vide)", "default": "tournois" },
    { "type": "text", "id": "cta_label", "label": "Bouton d'inscription", "default": "S’inscrire" },
    { "type": "url", "id": "fallback_link", "label": "Lien d'inscription par défaut", "info": "Utilisé si l'événement n'a ni produit-ticket ni lien." },
    { "type": "range", "id": "limit", "label": "Nombre d'événements", "min": 1, "max": 24, "step": 1, "default": 6 },
    { "type": "header", "content": "Source des événements" },
    { "type": "checkbox", "id": "use_metaobjects", "label": "Utiliser les metaobjects « Événement »", "default": true, "info": "Contenu > Metaobjects. Sans entrée, les blocs ci-dessous sont affichés." },
    { "type": "text", "id": "metaobject_type", "label": "Type du metaobject", "default": "evenement" },
    {
      "type": "select", "id": "scheme", "label": "Fond", "default": "dark",
      "options": [ { "value": "dark", "label": "Chocolat" }, { "value": "light", "label": "Crème" } ]
    },
    { "type": "text", "id": "anchor", "label": "Ancre (lien #…)", "default": "tournois" },
    { "type": "header", "content": "Espacements" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 120 }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Événement (sans metaobject)",
      "settings": [
        { "type": "text", "id": "date", "label": "Date (AAAA-MM-JJ)", "default": "2026-10-24" },
        { "type": "text", "id": "time", "label": "Heure", "default": "14h" },
        { "type": "text", "id": "game", "label": "Jeu", "default": "One Piece" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Store Tournament One Piece" },
        { "type": "text", "id": "price", "label": "Prix", "default": "8 €" },
        { "type": "product", "id": "product", "label": "Produit-ticket (inscription)" },
        { "type": "url", "id": "link", "label": "Ou lien d'inscription" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tournois et événements",
      "blocks": [
        { "type": "event", "settings": { "date": "2026-10-24", "time": "14h", "game": "One Piece", "title": "Store Tournament One Piece", "price": "8 €" } },
        { "type": "event", "settings": { "date": "2026-10-25", "time": "14h", "game": "One Piece", "title": "Store Tournament One Piece", "price": "8 €" } },
        { "type": "event", "settings": { "date": "2026-10-31", "time": "14h", "game": "One Piece", "title": "Store Tournament One Piece", "price": "8 €" } }
      ]
    }
  ]
}
{% endschema %}
