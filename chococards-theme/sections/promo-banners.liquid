{%- comment -%} Bannières promotionnelles (Accessoires, Retrait gratuit en boutique…) avec image en parallaxe. {%- endcomment -%}
<script src="{{ 'scroll-fx.js' | asset_url }}" type="module"></script>
{%- liquid
  assign s = section.settings
  assign anchor = s.anchor | default: section.id | handleize
-%}
<section class="section banners" id="{{ anchor }}" style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --banner-cols: {{ section.blocks.size | at_most: 3 | at_least: 1 }}">
  <div class="container banners__grid" data-reveal-stagger>
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <a class="banner holo-card{% if b.tint == 'violet' %} banner--pickup{% endif %}" href="{{ b.link | default: routes.all_products_collection_url }}"{% if settings.enable_holo %} data-tilt data-tilt-max="5"{% endif %} {{ block.shopify_attributes }}>
        <parallax-media class="banner__media">
          {%- if b.image -%}
            {{ b.image | image_url: width: 1600 | image_tag: class: 'banner__img', loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 50vw, 100vw', alt: b.image.alt }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg banner__img' }}
          {%- endif -%}
        </parallax-media>
        <div class="banner__content">
          {%- if b.eyebrow != blank -%}<p class="eyebrow eyebrow--light">{{ b.eyebrow }}</p>{%- endif -%}
          <h3 class="banner__title">{{ b.heading }}</h3>
          {%- if b.text != blank -%}<p>{{ b.text }}</p>{%- endif -%}
          {%- if b.button_label != blank -%}<span class="btn btn--light btn--sm">{{ b.button_label }}{% render 'icon', name: 'arrow' %}</span>{%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Bannières",
  "class": "section-banners",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (lien #…)", "default": "accessoires" },
    { "type": "header", "content": "Espacements" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 120 }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Bannière",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Accessoires" },
        { "type": "text", "id": "heading", "label": "Titre", "default": "Protégez vos trésors" },
        { "type": "text", "id": "text", "label": "Texte", "default": "Sleeves, classeurs, toploaders et protections acryliques UPC, ETB et Display." },
        { "type": "text", "id": "button_label", "label": "Bouton", "default": "Découvrir les accessoires" },
        { "type": "url", "id": "link", "label": "Lien" },
        {
          "type": "select", "id": "tint", "label": "Voile de couleur", "default": "choco",
          "options": [ { "value": "choco", "label": "Chocolat" }, { "value": "violet", "label": "Violet holo" } ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bannières",
      "blocks": [
        { "type": "banner", "settings": { "eyebrow": "Accessoires", "heading": "Protégez vos trésors", "text": "Sleeves, classeurs, toploaders et protections acryliques UPC, ETB et Display.", "button_label": "Découvrir les accessoires", "tint": "choco" } },
        { "type": "banner", "settings": { "eyebrow": "Click & Collect", "heading": "Retrait gratuit en boutique", "text": "Commandez en ligne, récupérez votre colis à Nivelles. Zéro frais de port.", "button_label": "Comment ça marche ?", "tint": "violet" } }
      ]
    }
  ]
}
{% endschema %}
