{{ 'templates.css' | asset_url | stylesheet_tag }}
<section class="account container page-hero">
  <div class="account-card">
    <h1>{{ 'customer.reset_title' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ResetPassword">{{ 'customer.password' | t }}</label><input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label for="ResetPasswordConfirm">{{ 'customer.password_confirm' | t }}</label><input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button class="btn btn--holo" type="submit" style="margin-top:12px"><span>{{ 'customer.reset' | t }}</span></button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Nouveau mot de passe", "settings": [] }
{% endschema %}
