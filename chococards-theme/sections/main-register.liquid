{{ 'templates.css' | asset_url | stylesheet_tag }}
<section class="account container page-hero">
  <div class="account-card">
    <h1>{{ 'customer.register_title' | t }}</h1>
    {%- form 'create_customer', novalidate: 'novalidate' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{% render 'icon', name: 'alert' %}{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="RegisterFirstName">{{ 'customer.first_name' | t }}</label><input id="RegisterFirstName" type="text" name="customer[first_name]" autocomplete="given-name" value="{{ form.first_name }}"></div>
      <div class="field"><label for="RegisterLastName">{{ 'customer.last_name' | t }}</label><input id="RegisterLastName" type="text" name="customer[last_name]" autocomplete="family-name" value="{{ form.last_name }}"></div>
      <div class="field"><label for="RegisterEmail">{{ 'customer.email' | t }}</label><input id="RegisterEmail" type="email" name="customer[email]" autocomplete="email" required value="{{ form.email }}"></div>
      <div class="field"><label for="RegisterPassword">{{ 'customer.password' | t }}</label><input id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <label class="checkbox"><input type="checkbox" name="customer[accepts_marketing]" value="true">{{ 'customer.accepts_marketing' | t }}</label>
      <button class="btn btn--holo" type="submit" style="margin-top:12px"><span>{{ 'customer.create' | t }}</span></button>
    {%- endform -%}
    <div class="account-links"><a href="{{ routes.account_login_url }}">{{ 'customer.have_account' | t }}</a></div>
  </div>
</section>

{% schema %}
{ "name": "Création de compte", "settings": [] }
{% endschema %}
