{%- comment -%} Blog « Guides & Actualités » : filtres par tag, grille d'articles, pagination. {%- endcomment -%}
{{ 'templates.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<div class="page-hero">
  <div class="container page-hero__inner">
    {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    <h1 class="page-hero__title">{{ blog.title }}</h1>
  </div>
</div>
<div class="container page-content">
  {%- if blog.all_tags.size > 0 -%}
    <nav class="blog-tags" aria-label="{{ 'blogs.tags' | t }}">
      <a href="{{ blog.url }}"{% unless current_tags %} aria-current="page"{% endunless %}>{{ 'blogs.all' | t }}</a>
      {%- for tag in blog.all_tags -%}
        <a href="{{ blog.url }}/tagged/{{ tag | handle }}"{% if current_tags contains tag %} aria-current="page"{% endif %}>{{ tag }}</a>
      {%- endfor -%}
    </nav>
  {%- endif -%}
  {%- paginate blog.articles by s.per_page -%}
    <div class="article-grid" data-reveal-stagger>
      {%- for article in blog.articles -%}
        {% render 'article-card', article: article, lazy: forloop.index %}
      {%- else -%}
        <p>{{ 'blogs.empty' | t }}</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog",
  "class": "section-main-blog",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Guides & Actualités" },
    { "type": "range", "id": "per_page", "label": "Articles par page", "min": 3, "max": 24, "step": 3, "default": 9 }
  ]
}
{% endschema %}
