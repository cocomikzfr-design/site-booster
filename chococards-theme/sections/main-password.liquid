{%- comment -%} Page « boutique bientôt ouverte » (mot de passe). {%- endcomment -%}
<section class="password">
  <div class="password__inner">
    {% render 'logo', size: 'lg' %}
    <h1 class="password__title">{{ section.settings.heading }} <span class="holo-text">{{ section.settings.heading_holo }}</span></h1>
    {%- if shop.password_message != blank -%}<p class="section-lead">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      <label class="visually-hidden" for="PasswordNewsletter">{{ 'newsletter.label' | t }}</label>
      <input id="PasswordNewsletter" type="email" name="contact[email]" required placeholder="{{ 'newsletter.placeholder' | t }}" autocomplete="email">
      <button class="btn btn--holo btn--sm" type="submit"><span>{{ 'newsletter.notify' | t }}</span></button>
      {%- if form.posted_successfully? -%}<p class="newsletter__msg is-ok" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
    {%- endform -%}
    <details>
      <summary class="link-arrow">{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password' -%}
        <div class="field">
          <label for="StorefrontPassword">{{ 'password.label' | t }}</label>
          <input id="StorefrontPassword" type="password" name="password" autocomplete="current-password"{% if form.errors %} aria-invalid="true"{% endif %}>
        </div>
        {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <button class="btn btn--ghost" type="submit"><span>{{ 'password.submit' | t }}</span></button>
      {%- endform -%}
    </details>
    <p class="product__tax">{{ 'password.admin_html' | t }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Mot de passe",
  "class": "section-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ouverture" },
    { "type": "text", "id": "heading_holo", "label": "Fin du titre (holographique)", "default": "imminente" }
  ]
}
{% endschema %}
