{%- comment -%} Page panier : lignes (quantités en AJAX), note, récapitulatif et paiement. {%- endcomment -%}
{{ 'templates.css' | asset_url | stylesheet_tag }}
<div class="page-hero">
  <div class="container page-hero__inner">
    <h1 class="page-hero__title">{{ 'cart.title' | t }}</h1>
  </div>
</div>
<cart-items class="cart-page container" data-section="{{ section.id }}">
  <div class="cart">
    {%- if cart.item_count > 0 -%}
      <div class="cart-page__grid">
        <ul class="cart-page__items" role="list">
          {%- for item in cart.items -%}
            {% render 'cart-line', item: item, index: forloop.index %}
          {%- endfor -%}
        </ul>
        <form class="cart-summary" action="{{ routes.cart_url }}" method="post">
          {%- for discount in cart.cart_level_discount_applications -%}
            <p class="cart__discounts">{{ discount.title }} (−{{ discount.total_allocated_amount | money }})</p>
          {%- endfor -%}
          <div class="cart__subtotal"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money_with_currency }}</strong></div>
          <p class="product__tax">{{ 'cart.taxes_shipping' | t }}</p>
          <p class="cart__note">{% render 'icon', name: 'store' %}{{ 'cart.pickup_note' | t: city: settings.store_city }}</p>
          {%- if section.settings.show_note -%}
            <div class="field">
              <label for="CartNote">{{ 'cart.note' | t }}</label>
              <textarea id="CartNote" name="note">{{ cart.note }}</textarea>
            </div>
          {%- endif -%}
          <button class="btn btn--holo cart__checkout" type="submit" name="checkout" data-magnetic>{% render 'icon', name: 'lock' %}<span>{{ 'cart.checkout' | t }}</span></button>
          {%- if additional_checkout_buttons and section.settings.show_dynamic_checkout -%}
            <div>{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </form>
      </div>
    {%- else -%}
      <div class="cart-empty">
        <div class="cart__empty-cards" aria-hidden="true"><span></span><span></span></div>
        <h2>{{ 'cart.empty' | t }}</h2>
        <p>{{ 'cart.empty_text' | t }}</p>
        <a class="btn btn--holo" href="{{ routes.all_products_collection_url }}" data-magnetic><span>{{ 'cart.continue' | t }}</span></a>
      </div>
    {%- endif -%}
  </div>
</cart-items>

{% schema %}
{
  "name": "Panier",
  "class": "section-main-cart",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Note de commande", "default": true },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Boutons de paiement accéléré", "default": true }
  ]
}
{% endschema %}
