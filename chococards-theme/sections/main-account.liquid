{{ 'templates.css' | asset_url | stylesheet_tag }}
<div class="page-hero">
  <div class="container page-hero__inner">
    <p class="eyebrow">{{ 'customer.account_title' | t }}</p>
    <h1 class="page-hero__title">{{ 'customer.hello' | t: name: customer.first_name }}</h1>
    <p><a class="link-arrow" href="{{ routes.account_logout_url }}">{{ 'customer.log_out' | t }}{% render 'icon', name: 'arrow' %}</a></p>
  </div>
</div>
<section class="account container">
  <div class="account__grid">
    <div>
      <h2 style="margin-bottom:16px">{{ 'customer.orders' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <div class="table-wrap">
            <table class="table">
              <thead><tr><th scope="col">{{ 'customer.order' | t }}</th><th scope="col">{{ 'customer.date' | t }}</th><th scope="col">{{ 'customer.payment' | t }}</th><th scope="col">{{ 'customer.fulfillment' | t }}</th><th scope="col">{{ 'customer.total' | t }}</th></tr></thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                    <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                    <td>{{ order.financial_status_label }}</td>
                    <td>{{ order.fulfillment_status_label }}</td>
                    <td>{{ order.total_net_amount | money_with_currency }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
          {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
        {%- else -%}
          <p>{{ 'customer.no_orders' | t }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
    <aside class="address-card">
      <h2>{{ 'customer.account_details' | t }}</h2>
      {{ customer.default_address | format_address }}
      <a class="link-arrow" href="{{ routes.account_addresses_url }}">{{ 'customer.view_addresses' | t: count: customer.addresses_count }}{% render 'icon', name: 'arrow' %}</a>
    </aside>
  </div>
</section>

{% schema %}
{ "name": "Compte client", "settings": [] }
{% endschema %}
